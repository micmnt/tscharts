{
	"name": "tscharts",
	"version": "1.3.0",
	"description": "Libreria di componenti React per grafici SVG, senza dipendenze runtime",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"main": "dist/index.es.js",
	"module": "dist/index.es.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.es.js"
		},
		"./transform": {
			"types": "./dist/transform.d.ts",
			"import": "./dist/transform.es.js"
		},
		"./style.css": "./dist/style.css"
	},
	"files": [
		"/dist"
	],
	"scripts": {
		"lint": "npx biome check --write",
		"lint:ci": "npx biome check",
		"build": "tsc && vite build",
		"test": "vitest run",
		"test:watch": "vitest",
		"storybook": "storybook dev -p 6006",
		"build:publish": "npm run lint && npm run build",
		"prepare": "npm run build",
		"prepublishOnly": "npm run build:publish",
		"release": "release-it"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"npm run lint"
		]
	},
	"keywords": [
		"react",
		"charts",
		"chart",
		"svg",
		"graph",
		"data-visualization",
		"typescript"
	],
	"author": "Michele Landolfi",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/micmnt/tscharts.git"
	},
	"bugs": {
		"url": "https://github.com/micmnt/tscharts/issues"
	},
	"homepage": "https://github.com/micmnt/tscharts#readme",
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@chromatic-com/storybook": "^5.3.0",
		"@storybook/addon-docs": "^10.5.7",
		"@storybook/addon-links": "^10.5.7",
		"@storybook/addon-onboarding": "^10.5.7",
		"@storybook/react": "^10.5.7",
		"@storybook/react-vite": "^10.5.7",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.18",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.3.0",
		"release-it": "^21.0.2",
		"storybook": "^10.5.7",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vite-plugin-dts": "^5.0.3",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"react": ">=18.2.0",
		"react-dom": ">=18.2.0"
	}
}
